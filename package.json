{
  "name": "02-weather",
  "version": "1.0.0",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run src/index.ts --watch",
    "test": "bun test --parallel",
    "test:watch": "bun test --watch",
    "build": "bun run typecheck && bun run test && bun build --compile src/index.ts --outfile dist/weather",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
